---
import Base from "../../layouts/Base.astro";
import { carregarPessoas, anoAtual, temFoto } from "../../lib/dados.js";
import { caminho } from "../../lib/caminho.js";
import {
  nomeProprio, minusculo, primeiraMaiuscula, localCandidatura,
  resultado, situacao, idade, nomeExibido, nomeUf, reais, bensPorTipo,
  dataBr, categoriaCota, participacaoSenado,
} from "../../lib/texto.js";

export function getStaticPaths() {
  const pessoas = carregarPessoas();
  const atual = anoAtual(pessoas);
  return pessoas.map((pessoa) => ({ params: { id: pessoa.id }, props: { pessoa, atual } }));
}

const { pessoa, atual } = Astro.props;
const deAgora = pessoa.candidaturas.filter((c) => c.ano === atual);
const recente = deAgora[0] ?? pessoa.candidaturas[0];
const nome = nomeExibido(recente, pessoa);
const anos = idade(pessoa.data_nascimento);
const foto = temFoto(pessoa.id) ? caminho(`fotos/${pessoa.id}.jpg`) : null;
const fotoCompleta = foto && Astro.site ? new URL(foto, Astro.site).href : undefined;

function descrever(c) {
  const partes = [`${primeiraMaiuscula(minusculo(c.cargo))} ${localCandidatura(c)}`];
  if (c.numero) partes.push(`número ${c.numero}`);
  if (c.partido?.sigla) partes.push(`partido ${c.partido.sigla}`);
  return partes.join(", ");
}
const descricao = deAgora.map(descrever).join("; ");

// Bens: uma declaração por eleição. Se houver mais de uma candidatura no mesmo
// ano, vale a apta; entre iguais, a que tem bens declarados.
const melhor = (a, b) => {
  const nota = (c) => [
    (c.situacao_candidatura ?? "").toUpperCase() === "APTO" ? 1 : 0,
    c.bens.length > 0 ? 1 : 0,
    c.total_bens ?? 0,
  ];
  const [na, nb] = [nota(a), nota(b)];
  for (let i = 0; i < na.length; i++) if (na[i] !== nb[i]) return na[i] > nb[i] ? a : b;
  return a;
};
const porAno = new Map();
for (const c of pessoa.candidaturas.filter((c) => c.bens != null)) {
  porAno.set(c.ano, porAno.has(c.ano) ? melhor(porAno.get(c.ano), c) : c);
}
const evolucao = [...porAno.values()]
  .map((c) => ({ ano: c.ano, total: c.total_bens }))
  .sort((a, b) => b.ano - a.ano);
const bensAtuais = evolucao.length ? porAno.get(evolucao[0].ano) : undefined;
const maiorTotal = Math.max(1, ...evolucao.map((e) => e.total));

// Mandatos no Congresso (gerar_parlamento.py).
const parlamento = pessoa.parlamento;
const cota = parlamento?.cota ?? [];
const variasCasas = new Set(cota.map((c) => c.casa)).size > 1;
const maiorCota = Math.max(1, ...cota.map((c) => c.total));
// Categorias: o ano completo mais recente; se só houver o ano atual, ele mesmo.
const anoHoje = new Date().getFullYear();
const cotaReferencia = cota.find((c) => c.ano < anoHoje) ?? cota[0];
// Página do deputado no site da Câmara (legislatura atual).
const atuacao = parlamento?.atuacao_camara ?? [];
const comPresenca = atuacao.filter((a) => a.presenca_plenario || a.presenca_comissoes);
const recursos = atuacao[0];
const perfilCamara = parlamento?.perfis.find((p) => p.casa === "Câmara dos Deputados");
const percentual = (n) => n.toLocaleString("pt-BR", { maximumFractionDigits: 2 });

const anteriores = [...new Set(pessoa.candidaturas.map((c) => c.ano))].sort((a, b) => b - a);
const fonteTse = (ano) => `https://dadosabertos.tse.jus.br/dataset/candidatos-${ano}`;
---
<Base
  titulo={`${nome}: Retrato no Alumia Aqui`}
  descricao={`Dados públicos e oficiais de ${nome}. ${descricao}.`}
  imagem={fotoCompleta}
>
  <article class="conteudo retrato">
    <header class="cabecalho" data-pagefind-body>
      {foto && (
        <img
          class="foto"
          src={foto}
          width="180"
          height="240"
          alt={`Foto de ${nome} entregue ao TSE`}
          data-pagefind-meta="image[src]"
        />
      )}
      <div>
      <p class="tipo">Retrato</p>
      <h1 data-pagefind-meta="title">{nome}</h1>
      {nomeProprio(pessoa.nome) !== nome && (
        <p class="nome-civil">{nomeProprio(pessoa.nome)}</p>
      )}
      <p class="descricao" data-pagefind-meta="descricao">{descricao}</p>
      {deAgora.length > 1 && (
        <p class="observacao">
          Esta pessoa registrou {deAgora.length} candidaturas em {atual}. Normalmente só uma segue na disputa.
        </p>
      )}
      </div>
    </header>

    <p class="aviso-fontes">
      Tudo nesta página vem de fontes oficiais, indicadas em cada seção.
      Não fazemos avaliação de candidatos.
    </p>

    <section>
      <h2>Quem é</h2>
      <dl class="ficha">
        <div><dt>Nome completo</dt><dd>{nomeProprio(pessoa.nome)}</dd></div>
        {anos !== null && <div><dt>Idade</dt><dd>{anos} anos</dd></div>}
        {pessoa.uf_nascimento && <div><dt>Nasceu em</dt><dd>{nomeUf(pessoa.uf_nascimento)}</dd></div>}
        {recente.escolaridade && <div><dt>Escolaridade declarada</dt><dd>{primeiraMaiuscula(minusculo(recente.escolaridade))}</dd></div>}
        {recente.ocupacao && <div><dt>Ocupação declarada</dt><dd>{primeiraMaiuscula(minusculo(recente.ocupacao))}</dd></div>}
      </dl>
      <p class="fonte">Fonte: <a href={fonteTse(recente.ano)}>TSE, candidatos de {recente.ano}</a>. Informações declaradas pelo próprio candidato.{foto && " A foto é a entregue ao TSE no registro da candidatura."}</p>
    </section>

    {parlamento && (
      <section>
        <h2>O que fez no Congresso?</h2>
        <p class="explica">Mandatos na Câmara dos Deputados e no Senado Federal desde {parlamento.desde}.</p>
        <ul class="mandatos">
          {parlamento.mandatos.map((m) => (
            <li>
              <strong>{m.casa}</strong>, representando {nomeUf(m.uf)}, de {m.inicio} a {m.fim}
              {m.partido && <> ({m.partido.includes(",") ? "partidos" : "partido"} {m.partido})</>}
              {m.participacao && <>, {participacaoSenado(m.participacao)}</>}
            </li>
          ))}
        </ul>

        {comPresenca.length > 0 && (
          <>
            <h3 class="sub">Presença na Câmara</h3>
            <p class="explica">
              No Plenário, a Câmara conta os dias com sessão de votação; nas comissões, as reuniões.
              Falta não justificada no Plenário gera desconto no salário.
            </p>
            <ul class="presencas">
              {comPresenca.map((a) => (
                <li>
                  <p class="ano-bens">{a.ano}{a.ano === anoHoje && ", até agora"}</p>
                  {a.presenca_plenario && (
                    <p>
                      <strong>Plenário:</strong> presente em {a.presenca_plenario.presencas} dias.
                      Ausências justificadas: {a.presenca_plenario.ausencias_justificadas}.
                      Não justificadas: {a.presenca_plenario.ausencias_nao_justificadas}.
                    </p>
                  )}
                  {a.presenca_comissoes && (
                    <p>
                      <strong>Comissões:</strong> presente em {a.presenca_comissoes.presencas} reuniões.
                      Ausências justificadas: {a.presenca_comissoes.ausencias_justificadas}.
                      Não justificadas: {a.presenca_comissoes.ausencias_nao_justificadas}.
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </>
        )}

        <h3 class="sub">Projetos que apresentou</h3>
        {parlamento.proposicoes.autor + parlamento.proposicoes.coautor === 0 ? (
          <p>Nenhum projeto de lei, PEC ou projeto de decreto legislativo apresentado desde {parlamento.desde}.</p>
        ) : (
          <>
            <p>
              <strong>{parlamento.proposicoes.autor}</strong>
              {parlamento.proposicoes.autor === 1 ? " projeto" : " projetos"} com autoria principal desde {parlamento.desde}
              {parlamento.proposicoes.coautor > 0 && <>, e {parlamento.proposicoes.coautor} em coautoria</>}.
            </p>
            {parlamento.proposicoes.por_tipo.length > 1 && (
              <ul class="bens">
                {parlamento.proposicoes.por_tipo.map((t) => (
                  <li><span>{t.nome} ({t.tipo})</span><span class="valor">{t.quantidade}</span></li>
                ))}
              </ul>
            )}
            <p class="explica nota">
              Apresentar um projeto não quer dizer que ele virou lei. A situação mostra em que etapa cada um está.
            </p>
            {parlamento.proposicoes.recentes.length > 0 && (
              <>
                <h4>Mais recentes com autoria principal</h4>
                <ol class="projetos">
                  {parlamento.proposicoes.recentes.map((p) => (
                    <li>
                      <p><a href={p.url}>{p.identificacao}</a>, apresentado em {dataBr(p.data)}</p>
                      <p class="ementa">{p.ementa}</p>
                      {p.situacao && <p class="situacao-projeto">Situação: {primeiraMaiuscula(minusculo(p.situacao))}</p>}
                    </li>
                  ))}
                </ol>
              </>
            )}
          </>
        )}

        {cota.length > 0 && (
          <>
            <h3 class="sub">Gastos com a cota parlamentar</h3>
            <p class="explica">
              A cota parlamentar é uma verba para despesas do mandato, como passagens, escritório e divulgação.
              O valor máximo por mês muda conforme o estado.
            </p>
            <p class="explica">
              Os comprovantes de um mês costumam entrar nos dados abertos semanas depois. Por isso, o valor
              do ano atual pode estar abaixo do que aparece no site da Câmara ou do Senado.
            </p>
            <ul class="evolucao">
              {cota.map((c) => (
                <li>
                  <span class="ano-bens">{c.ano}</span>
                  <span class="barra" style={`--tamanho: ${(c.total / maiorCota) * 100}%`}></span>
                  <span class="valor">
                    {reais(c.total)}{c.ano === anoHoje && " até agora"}
                    {variasCasas && <span class="casa"> ({c.casa})</span>}
                  </span>
                </li>
              ))}
            </ul>
            {cotaReferencia && (
              <>
                <h4>Em que gastou em {cotaReferencia.ano}</h4>
                <ul class="bens">
                  {cotaReferencia.categorias.slice(0, 8).map((g) => (
                    <li><span>{categoriaCota(g.nome)}</span><span class="valor">{reais(g.valor)}</span></li>
                  ))}
                </ul>
              </>
            )}
          </>
        )}

        {recursos && (
          <>
            <h3 class="sub">Salário e recursos do mandato em {recursos.ano}</h3>
            <dl class="ficha">
              {recursos.salario_bruto && (
                <div><dt>Salário bruto</dt><dd>{reais(recursos.salario_bruto)} por mês, igual para todos os deputados federais</dd></div>
              )}
              {recursos.imovel_funcional && (
                <div><dt>Imóvel funcional em Brasília</dt><dd>{recursos.imovel_funcional}</dd></div>
              )}
              {recursos.auxilio_moradia && (
                <div><dt>Auxílio-moradia</dt><dd>{recursos.auxilio_moradia}</dd></div>
              )}
              {recursos.verba_gabinete?.gasto != null && (
                <div>
                  <dt>Verba de gabinete</dt>
                  <dd>
                    {reais(recursos.verba_gabinete.gasto)}
                    {recursos.verba_gabinete.percentual != null && <> ({percentual(recursos.verba_gabinete.percentual)}% do limite)</>}
                  </dd>
                </div>
              )}
              {recursos.pessoal_gabinete && (
                <div><dt>Pessoal de gabinete</dt><dd>{recursos.pessoal_gabinete}</dd></div>
              )}
              {recursos.viagens_missao_oficial != null && (
                <div><dt>Viagens em missão oficial</dt><dd>{recursos.viagens_missao_oficial}</dd></div>
              )}
            </dl>
            <p class="explica nota">
              A verba de gabinete paga os salários dos secretários parlamentares, escolhidos pelo próprio deputado.
              O imóvel funcional é um apartamento da Câmara em Brasília; quem não usa pode receber o auxílio-moradia.
            </p>
          </>
        )}

        <p class="fonte">
          Fonte: dados abertos da Câmara dos Deputados e do Senado Federal
          {atuacao.length > 0 && <>; presença, salário e recursos do mandato vêm da página do deputado no site da Câmara</>}.
          Perfil oficial:{" "}
          {parlamento.perfis.map((perfil, i) => (
            <>{i > 0 && ", "}<a href={perfil.url}>{perfil.casa}</a></>
          ))}.
        </p>
      </section>
    )}

    {bensAtuais && (
      <section>
        <h2>Quanto declarou de bens?</h2>
        {bensAtuais.bens.length === 0 ? (
          <p>Não declarou bens ao registrar a candidatura de {bensAtuais.ano}.</p>
        ) : (
          <>
            <p class="total-bens">{reais(bensAtuais.total_bens)}</p>
            <p class="explica">
              Total declarado na candidatura de {bensAtuais.ano}, em {bensAtuais.bens.length}
              {bensAtuais.bens.length === 1 ? " item" : " itens"}.
            </p>
            <ul class="bens">
              {bensPorTipo(bensAtuais.bens).map((g) => (
                <li>
                  <span>{g.tipo}{g.quantidade > 1 && ` (${g.quantidade})`}</span>
                  <span class="valor">{reais(g.valor)}</span>
                </li>
              ))}
            </ul>
          </>
        )}
        {evolucao.length > 1 && (
          <>
            <h3 class="sub">Total declarado em cada eleição</h3>
            <ul class="evolucao">
              {evolucao.map((e) => (
                <li>
                  <span class="ano-bens">{e.ano}</span>
                  <span class="barra" style={`--tamanho: ${(e.total / maiorTotal) * 100}%`}></span>
                  <span class="valor">{e.total > 0 ? reais(e.total) : "Nenhum bem"}</span>
                </li>
              ))}
            </ul>
          </>
        )}
        <p class="fonte">
          Fonte: <a href={fonteTse(bensAtuais.ano)}>TSE, bens de candidatos</a>. Valores declarados pelo
          próprio candidato ao registrar a candidatura, sem correção pela inflação.
        </p>
      </section>
    )}

    <section>
      <h2>Quais eleições já disputou?</h2>
      <p class="explica">Todas as candidaturas registradas no TSE desde 2014, da mais recente para a mais antiga.</p>
      <ol class="linha-do-tempo">
        {pessoa.candidaturas.map((c) => (
          <li>
            <p class="ano">{c.ano}</p>
            <div class="evento">
              <h3>{primeiraMaiuscula(minusculo(c.cargo))} {localCandidatura(c)}</h3>
              <p>
                {c.partido?.sigla && <>Partido {c.partido.sigla}{c.partido.nome && ` (${nomeProprio(c.partido.nome)})`}</>}
                {c.numero && <>, número {c.numero}</>}
              </p>
              {situacao(c.situacao_candidatura) && <p>{situacao(c.situacao_candidatura)}</p>}
              {c.turnos.filter((t) => resultado(t.resultado)).map((t) => (
                <p class="resultado">
                  {c.turnos.length > 1 && `${t.turno}º turno: `}{resultado(t.resultado)}
                </p>
              ))}
              {c.ano === atual && !c.turnos.some((t) => resultado(t.resultado)) && (
                <p class="resultado">Eleição ainda não apurada</p>
              )}
            </div>
          </li>
        ))}
      </ol>
      <p class="fonte">
        Fonte: TSE, dados abertos de candidatos ({anteriores.map((ano, i) => (
          <>{i > 0 && ", "}<a href={fonteTse(ano)}>{ano}</a></>
        ))}).
      </p>
    </section>

    <section>
      <h2>O que ainda não está aqui</h2>
      <p>
        Contas de campanha, votações no Congresso, presença de senadores e de deputados em mandatos anteriores, mandatos anteriores a 2015,
        mandatos em assembleias estaduais e câmaras municipais, processos e sanções ainda
        não foram incluídos no Alumia Aqui. A ausência dessas informações nesta página não
        significa que elas não existam.
      </p>
    </section>
  </article>
</Base>

<style>
  .retrato { padding-top: 1.75rem; padding-bottom: 2.5rem; }
  .cabecalho { display: flex; gap: 1.25rem; align-items: flex-start; }
  .foto {
    flex: 0 0 auto; width: 7.5rem; height: 10rem; object-fit: cover;
    border-radius: var(--raio); background: var(--borda);
    box-shadow: 0 0 0 4px var(--luz);
  }
  @media (max-width: 30rem) { .foto { width: 5.5rem; height: 7.33rem; } .cabecalho { gap: 1rem; } }
  .tipo { color: var(--tinta-suave); font-weight: 700; }
  h1 { font-size: clamp(2rem, 7vw, 2.8rem); letter-spacing: -0.015em; margin-top: 0.15rem; }
  .nome-civil { font-size: 1.15rem; margin-top: 0.25rem; }
  .descricao { font-size: 1.15rem; margin-top: 0.75rem; }
  .observacao { margin-top: 0.5rem; color: var(--tinta-suave); }

  .aviso-fontes {
    margin: 1.5rem 0 0;
    padding: 0.9rem 1.1rem;
    background: var(--luz);
    border-radius: var(--raio);
  }

  section { margin-top: 2.25rem; }
  h2 { font-size: 1.45rem; margin-bottom: 0.75rem; }
  .explica { color: var(--tinta-suave); margin-bottom: 1rem; }
  .fonte { margin-top: 1rem; font-size: 0.9rem; color: var(--tinta-suave); }
  .fonte a { color: var(--tinta-suave); }

  .ficha { margin: 0; display: grid; gap: 0.6rem; }
  .ficha div { display: grid; grid-template-columns: minmax(9rem, 14rem) 1fr; gap: 0.25rem 1rem; }
  .ficha dt { color: var(--tinta-suave); }
  .ficha dd { margin: 0; font-weight: 700; }
  @media (max-width: 30rem) { .ficha div { grid-template-columns: 1fr; gap: 0; } }

  /* A linha do tempo: um trilho à esquerda, um ponto por eleição */
  .linha-do-tempo { list-style: none; margin: 0; padding: 0; }
  .linha-do-tempo li {
    display: grid; grid-template-columns: 4rem 1fr; gap: 1rem;
    position: relative; padding-bottom: 1.25rem;
  }
  .linha-do-tempo li::before {
    content: ""; position: absolute; left: 4.45rem; top: 0.5rem; bottom: -0.5rem;
    width: 3px; background: var(--borda);
  }
  .linha-do-tempo li:last-child::before { display: none; }
  .ano { font-weight: 700; font-size: 1.15rem; }
  .evento { position: relative; padding-left: 1.1rem; }
  .evento::before {
    content: ""; position: absolute; left: -0.95rem; top: 0.45rem;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--luz-forte); border: 3px solid var(--noite);
  }
  h3 { font-size: 1.1rem; }
  .sub { margin: 1.5rem 0 0.5rem; }
  h4 { font-size: 1rem; margin: 1.25rem 0 0.5rem; }
  .nota { margin-top: 0.75rem; }
  .mandatos { margin: 0; padding-left: 1.25rem; }
  .mandatos li { margin-top: 0.35rem; }
  .projetos { list-style: none; margin: 0; padding: 0; }
  .projetos li { padding: 0.75rem 0; border-bottom: 2px solid var(--borda); }
  .projetos a { font-weight: 700; }
  .ementa { margin-top: 0.25rem; }
  .situacao-projeto { color: var(--tinta-suave); font-size: 0.95rem; margin-top: 0.25rem; }
  .casa { font-weight: 400; color: var(--tinta-suave); }
  .presencas { list-style: none; margin: 0; padding: 0; }
  .presencas li { padding: 0.6rem 0; border-bottom: 2px solid var(--borda); }
  .presencas p + p { margin-top: 0.25rem; }

  .total-bens { font-size: clamp(1.8rem, 6vw, 2.4rem); font-weight: 700; line-height: 1.1; }
  .total-bens + .explica { margin-top: 0.25rem; }
  .bens, .evolucao { list-style: none; margin: 0; padding: 0; }
  .bens li {
    display: flex; justify-content: space-between; gap: 1rem;
    padding: 0.5rem 0; border-bottom: 2px solid var(--borda);
  }
  .valor { font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; }

  .evolucao li {
    display: grid; grid-template-columns: 3.5rem 1fr auto; gap: 0.75rem;
    align-items: center; padding: 0.3rem 0;
  }
  .ano-bens { font-weight: 700; }
  .barra { height: 0.9rem; border-radius: 0 6px 6px 0; background: var(--borda); position: relative; }
  .barra::after {
    content: ""; position: absolute; inset: 0 auto 0 0; width: var(--tamanho);
    min-width: 3px; border-radius: inherit; background: var(--luz-forte);
  }
  @media (max-width: 30rem) {
    .evolucao li { grid-template-columns: 3.5rem 1fr; }
    .evolucao .valor { grid-column: 2; }
  }
  .resultado { font-weight: 700; }
</style>
