---
// Lanterna apontando para baixo. A luz sai pela ponta inferior.
interface Props {
  tamanho?: number;
  classe?: string;
}
const { tamanho = 48, classe = "" } = Astro.props;
---
<svg
  class={classe}
  width={tamanho}
  height={tamanho}
  viewBox="0 0 48 48"
  aria-hidden="true"
  focusable="false"
>
  <rect x="17" y="3" width="14" height="24" rx="4" fill="currentColor" />
  <rect x="21" y="10" width="6" height="5" rx="1.5" fill="var(--luz)" />
  <path d="M15 27 h18 l4 9 h-26 z" fill="currentColor" />
  <ellipse cx="24" cy="36.5" rx="13" ry="3" fill="var(--luz)" />
</svg>
